#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
. "${plugin_dir}/lib/utils.bash"

curl_opts=(-sSI)

if [ -n "$gh_token" ]; then
	curl_opts=("${curl_opts[@]}" -H "Authorization: token $gh_token")
fi

# curl of REPO/releases/latest is expected to be a 302 to another URL
# when there are releases redirect_url="REPO/releases/tag/v<VERSION>"
# anything else (no releases yet, a rate limit, a network error) falls back to
# the newest tag rather than reporting no version at all
redirect_url="$(curl "${curl_opts[@]}" "$GH_REPO/releases/latest" |
	sed -n -e 's|^[Ll]ocation: *||p' | tr -d '\r' | tail -n 1)" || true

version=
if [[ "$redirect_url" == */releases/tag/* ]]; then
	version="$(printf "%s\n" "$redirect_url" | sed 's|.*/tag/v\{0,1\}||')"
else
	version="$(list_all_versions | sort_versions | tail -n1 | xargs echo)"
fi

if [ -z "$version" ]; then
	fail "Could not determine the latest stable version of $TOOL_NAME."
fi

printf "%s\n" "$version"
